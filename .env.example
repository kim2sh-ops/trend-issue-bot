# cp .env.example .env 후 채우기. .env 는 git 에 올라가지 않음.

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# @BotFather 에서 봇 생성 후 받는 토큰
TELEGRAM_BOT_TOKEN=123456:ABC-...

# 봇에게 아무 메시지나 보낸 뒤:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# 응답의 message.chat.id 값 (본인 DM 이면 양수, 그룹이면 음수)
TELEGRAM_CHAT_ID=123456789

# 카드뉴스·릴스에 박히는 인스타 핸들
IG_HANDLE=@my_trend_account

# 선택: 모델 교체 (기본 claude-haiku-4-5). 품질 아쉬우면 claude-sonnet-5
CLAUDE_MODEL=claude-haiku-4-5
